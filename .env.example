# Copy this to .env in THIS folder and fill in. The class-project reads from
# this folder's .env, not the repository root, so it works as a standalone
# extract: copy the folder to an empty directory, drop in your own .env, and
# the ETL runs.

DB_URL=postgresql://user:password@host:5432/database

# Optional: which schema the ETL writes its outputs into. Default is my_work.
LEARNER_SCHEMA=my_work